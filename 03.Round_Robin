#include <stdio.h>

int main() {
    int n, quantum, current_time = 0, completed = 0;
    printf("Enter the number of processes: ");
    scanf("%d", &n);

    int pid[n], at[n], bt[n], rem_bt[n], ct[n], tat[n], wt[n];
    int queue[100], front = 0, rear = 0;
    int visited[n]; // To track if a process is already in the queue

    for(int i = 0; i < n; i++) {
        pid[i] = i + 1;
        printf("Enter arrival time for process %d: ", i + 1);
        scanf("%d", & at[i]);
        printf("Enter burst time for process %d: ", i + 1);
        scanf("%d", & bt[i]);
        rem_bt[i] = bt[i];
        visited[i] = 0;
    }

    printf("Enter time quantum: ");
    scanf("%d", &quantum);

    // Step 1: Add processes that arrived at time 0 to the queue
    for(int i = 0; i < n; i++) {
        if(at[i] <= current_time) {
            queue[rear++] = i;
            visited[i] = 1;
        }
    }

    // Step 2: Process the queue
    while(front < rear) {       // While there are processes in the queue
        int i = queue[front++]; // Dequeue the next process

        // Execute process for quantum or remaining time
        if(rem_bt[i] > quantum) {
            current_time += quantum;
            rem_bt[i] -= quantum;
        } else {
            current_time += rem_bt[i];
            rem_bt[i] = 0;
            completed++;
            ct[i] = current_time;
            tat[i] = ct[i] - at[i];
            wt[i] = tat[i] - bt[i];
        }

        // Step 3: Check for new arrivals while the current process was running
        for(int j = 0; j < n; j++) {
            if(at[j] <= current_time && visited[j] == 0) {
                queue[rear++] = j;
                visited[j] = 1;
            }
        }

        // Step 4: If current process is NOT finished, add it back to the end
        if(rem_bt[i] > 0) {
            queue[rear++] = i;
        }

        // Step 5: If queue is empty but processes are left (CPU idle gap)
        if(front == rear && completed < n) {
            for(int j = 0; j < n; j++) {
                if(visited[j] == 0) {
                    current_time = at[j];
                    queue[rear++] = j;
                    visited[j] = 1;
                    break;
                }
            }
        }
    }

    // Display Results
    printf("\nPN\tAT\tBT\tCT\tTAT\tWT\n");
    for(int i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\t%d\n", pid[i], at[i], bt[i], ct[i], tat[i], wt[i]);
    }

    return 0;
}


