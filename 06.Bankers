#include <stdio.h>

int main() {
    int n, m, i, j, k;

    // Standard input for process and resource count
    printf("Enter number of processes: ");
    scanf("%d", &n);
    printf("Enter number of resources: ");
    scanf("%d", &m);

    int alloc[n][m], max[n][m], avail[m], need[n][m], f[n], ans[n], ind = 0;

    // Initialize the finish array to 0
    for (i = 0; i < n; i++) f[i] = 0;

    // Input Allocation Matrix with helpful labels
    printf("\n--- Enter Allocation Matrix ---\n");
    for (i = 0; i < n; i++) {
        for (j = 0; j < m; j++) {
            printf("P%d Resource %d: ", i, j);
            scanf("%d", &alloc[i][j]);
        }
    }

    // Input Max Matrix
    printf("\n--- Enter Max Matrix ---\n");
    for (i = 0; i < n; i++) {
        for (j = 0; j < m; j++) {
            printf("P%d Max Resource %d: ", i, j);
            scanf("%d", &max[i][j]);
        }
    }

    // Input Available Resources
    printf("\n--- Enter Available Resources ---\n");
    for (i = 0; i < m; i++) {
        printf("Resource %d: ", i);
        scanf("%d", &avail[i]);
    }

    // Calculate Need Matrix
    for (i = 0; i < n; i++) {
        for (j = 0; j < m; j++) {
            need[i][j] = max[i][j] - alloc[i][j];
        }
    }

    // Banker's Algorithm Safety Logic
    for (k = 0; k < n; k++) {
        for (i = 0; i < n; i++) {
            if (f[i] == 0) {
                int flag = 0;
                for (j = 0; j < m; j++) {
                    if (need[i][j] > avail[j]) {
                        flag = 1;
                        break;
                    }
                }

                if (flag == 0) {
                    ans[ind++] = i;
                    for (int y = 0; y < m; y++)
                        avail[y] += alloc[i][y];
                    f[i] = 1;
                }
            }
        }
    }

    // Check if the system is in a safe state
    int isSafe = 1;
    for(i = 0; i < n; i++) {
        if(f[i] == 0) {
            isSafe = 0;
            printf("\nWarning: The system is NOT in a safe state.\n");
            break;
        }
    }

    if(isSafe) {
        printf("\nFollowing is the SAFE Sequence:\n");
        for (i = 0; i < n - 1; i++)
            printf(" P%d ->", ans[i]);
        printf(" P%d\n", ans[n - 1]);
    }

    return 0;
}
